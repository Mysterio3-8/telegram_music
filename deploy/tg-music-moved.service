[Unit]
Description=Telegram Music — старый бот @tgram_music_bot, отвечает «мы переехали»
After=network-online.target
# Рубеж против шторма рестартов: пять смертей за 5 минут, и systemd сдаётся,
# вместо того чтобы поднимать юнит вечно. ⚠️ Именно в [Unit] — в [Service]
# systemd эти ключи не читает.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/tg-music-bot
ExecStart=/opt/tg-music-bot/.venv/bin/python -m app.moved_bot
Restart=always
RestartSec=5
# 🔴 Найдено 16.08: токен старого бота отозвали, и юнит падал на старте 511 раз
# подряд. `Restart=always` в такой ситуации не защита, а генератор нагрузки —
# каждый заход это полный импорт Python с aiogram, четверть единственного ядра,
# круглосуточно (ровно так `tg-music-worker` 01.08 довёл load average до 15).
#
# 78 = EX_CONFIG, его отдаёт app/moved_bot.py, когда Telegram отвечает
# Unauthorized: отозванный токен сам не починится, и повторять попытки бессмысленно.
RestartPreventExitStatus=78
# Указатель, а не сервис: при нехватке памяти его не жалко
OOMScoreAdjust=200
MemoryHigh=80M

[Install]
WantedBy=multi-user.target
