[Unit]
Description=Telegram Music Bot — user-requested link import worker (Celery, queue=youtube_user)
After=network-online.target redis-server.service
Wants=network-online.target
Requires=redis-server.service
# Предохранитель от рестарт-шторма — см. tg-music-worker.service (инцидент 2026-08-01).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
WorkingDirectory=/opt/tg-music-bot
# Ссылки, которые пользователь сам кинул боту (upload.py) — своя очередь, чтобы
# не ждать за бэклогом массовых сканов каналов/плейлистов в очереди youtube.
ExecStart=/opt/tg-music-bot/.venv/bin/celery -A app.tasks.celery_app worker \
    -Q youtube_user \
    -n youtube-user@%%h \
    --pool=threads --concurrency=2 \
    --without-gossip --without-mingle --without-heartbeat \
    --loglevel=info
Restart=always
RestartSec=15
# Эта очередь несёт поисковый парсер (search.fetch) — сейчас приоритетная фича
# (массовый 24/7-парсер временно выключен, см. tg-music-soundcloud/youtube).
# Не топ-приоритет как у бота, но и не первый на убой.
#
# 11.08 замер показал воркер вплотную к потолку: Memory 236M при MemoryMax=250M,
# peak ровно 250M. Голый жёсткий лимит в этом положении не защищает, а убивает:
# ровно так 01.08 родилась OOM-петля с рестартом каждые 6 секунд. Мягкий
# MemoryHigh сначала отбирает страницы и притормаживает процесс — скачивание
# станет медленнее, но не оборвётся; MemoryMax остаётся как страховка от течи.
#
# 11.08, вечер: с потолком 400M сторож поймал 48 МБ свободной памяти на боксе с
# 961 МБ — при живых боте, API, втором воркере и Redis столько отдавать одному
# процессу нельзя. Оставляем запас над замеренными 236 МБ, но не такой щедрый.
MemoryHigh=260M
MemoryMax=340M

[Install]
WantedBy=multi-user.target
