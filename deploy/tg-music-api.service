[Unit]
Description=Telegram Music public API (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/tg-music-bot
ExecStart=/opt/tg-music-bot/.venv/bin/uvicorn app.api.app:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=3
# Защита от OOM (инцидент 2026-07-26/27): API — бэкенд Mini App, приоритетный
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
