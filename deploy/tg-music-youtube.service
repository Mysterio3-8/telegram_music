[Unit]
Description=Telegram Music Bot — YouTube import worker (Celery, queue=youtube)
After=network-online.target redis-server.service
Wants=network-online.target
Requires=redis-server.service
# Предохранитель от рестарт-шторма — см. tg-music-worker.service (инцидент 2026-08-01).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
WorkingDirectory=/opt/tg-music-bot
# Ограниченная параллельность загрузок (доп. ТЗ §14); N = YOUTUBE_CONCURRENCY
ExecStartPre=/opt/tg-music-bot/.venv/bin/python -m app.cli.youtube recover
ExecStart=/opt/tg-music-bot/.venv/bin/celery -A app.tasks.celery_app worker \
    -Q youtube \
    -n youtube@%%h \
    --pool=threads --concurrency=1 \
    --without-gossip --without-mingle --without-heartbeat \
    --loglevel=info
Restart=always
RestartSec=15
MemoryMax=200M
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
