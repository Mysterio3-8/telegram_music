[Unit]
Description=Telegram Music Bot — медленный прогрев каталога по списку артистов владельца
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/tg-music-bot
# Темп задал владелец (21.09): один трек в 30–60 секунд. За час это ~45 треков,
# то есть 4 артиста по 10 треков укладываются в ~30 минут и оставляют машине
# полчаса тишины до следующего запуска.
#
# ⚠️ Почему по именам артистов, а не по названиям треков: в присланном списке у
# десятков артистов повторялись выдуманные названия («Город», «Капли», «Окна»),
# а поиск при слабом совпадении отдаёт верх выдачи — в базу лёг бы чужой трек.
# Настоящий топ артиста знает сам источник.
# ⚠️ --state обязателен: без него каждый запуск брал бы первые имена списка и
# никогда не дошёл бы до хвоста. Файл вне репозитория — деплой делает git reset.
ExecStart=/opt/tg-music-bot/.venv/bin/python -m app.cli.warmup --artists data/popular-artists.txt --per-artist 10 --limit 4 --delay 45 --state /var/lib/tg-music/warmup-artists.done

# Память: бокс 961 МБ, свободно бывает меньше сотни. MemoryHigh притормаживает
# процесс, MemoryMax — страховка от течи. CPUWeight ниже обычного: прогрев ждёт,
# а не мешает живым запросам людей.
MemoryHigh=260M
MemoryMax=340M
CPUWeight=20
Nice=10
TimeoutStartSec=3600
