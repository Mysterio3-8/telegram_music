[Unit]
Description=Telegram Music Bot — SoundCloud import worker (Celery, queue=soundcloud)
After=network-online.target redis-server.service
Wants=network-online.target
Requires=redis-server.service
# Предохранитель от рестарт-шторма — см. tg-music-worker.service (инцидент 2026-08-01).
StartLimitIntervalSec=300
StartLimitBurst=5
# Массовый парсер выключен решением владельца: бокс 961 МБ его не тянет. `disable`
# не защищает от ручного `systemctl start` — 2026-08-03 его так и подняли: память
# ушла в ноль, поиск встал, а в Redis набилась очередь на 177 тысяч задач (176 МБ).
# Включить осознанно: touch /etc/tg-music-mass-parser-on
ConditionPathExists=/etc/tg-music-mass-parser-on

[Service]
WorkingDirectory=/opt/tg-music-bot
# Своя очередь и свой воркер — не делит concurrency с youtube (там бэклог из
# сотен поштучных импортов). concurrency=1 — бокс 961МБ RAM не тянет больше
# (инцидент 2026-07-26: concurrency=3 + дискавери → OOM убивал Redis/бота).
# На большем сервере вернуть 3+ для темпа к 1М.
# (SPEC-КАТАЛОГ §4): 7 прокси в ротации размазывают параллельные запросы по
# разным IP, анти-бан-паузы остаются на каждой задаче. Без прокси вернуть 1.
ExecStart=/opt/tg-music-bot/.venv/bin/celery -A app.tasks.celery_app worker \
    -Q soundcloud \
    -n soundcloud@%%h \
    --pool=threads --concurrency=1 \
    --without-gossip --without-mingle --without-heartbeat \
    --loglevel=info
Restart=always
RestartSec=15
# Защита памяти (инцидент 2026-07-26/27): массовый парсер не должен ронять бота
MemoryMax=200M
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
